/**
 * Tests de la extracción de comercio y las reglas aprendidas.
 * Ejecutar con: bun run test
 */
import { describe, it, expect } from 'vitest';
import { extraerComercio, categoriaPorReglas } from './categoryRules';

describe('extraerComercio — casos generales', () => {
  it('quita "PAGO TARJETA", números y lugar', () => {
    expect(extraerComercio('PAGO TARJETA 4587 SUPERCOR SEVILLA ESTE 12/03')).toBe('SUPERCOR');
  });
  it('conserva comercios de dos palabras', () => {
    expect(extraerComercio('PAGO CON TARJETA LEROY MERLIN 4021 SEVILLA')).toBe('LEROY MERLIN');
  });
  it('quita el dominio .com pero conserva la marca', () => {
    expect(extraerComercio('NETFLIX.COM 03/2026')).toBe('NETFLIX');
  });
  it('concepto vacío devuelve cadena vacía', () => {
    expect(extraerComercio('')).toBe('');
    expect(extraerComercio('   ')).toBe('');
  });
});

describe('extraerComercio — conceptos reales del Santander', () => {
  it('transferencia con concepto al final → coge el concepto (alquiler)', () => {
    expect(extraerComercio('Transferencia Inmediata A Favor De Estrella Maria Rojas Cuesta Concepto Alquiler Septiembre 2026')).toBe('ALQUILER');
  });
  it('transferencia Digi', () => {
    expect(extraerComercio('Transferencia Inmediata A Favor De Ruben Cabrera Garcia Concepto Digi Septiembre')).toBe('DIGI');
  });
  it('bizum con "Concepto:" → Apple Music', () => {
    expect(extraerComercio('Bizum A Favor De Daniel Benitez De Miguel Concepto: Apple Music')).toBe('APPLE MUSIC');
  });
  it('bizum con concepto de una palabra', () => {
    expect(extraerComercio('Bizum De Estrella Maria Rojas Cuesta Concepto Movil')).toBe('MOVIL');
  });
  it('"Pago Movil En X" → coge el comercio, no la muletilla', () => {
    expect(extraerComercio('Pago Movil En M I Nutrition, Dos Hermanas Es, Tarj. :*665417')).toContain('NUTRITION');
    expect(extraerComercio('Pago Movil En Dia, S.a., Dos Hermanas Es')).toBe('DIA');
  });
  it('pago con tarjeta normal sigue funcionando', () => {
    expect(extraerComercio('Compra Crunchyroll.com, Coppell, Tarjeta 5489010542665417')).toBe('CRUNCHYROLL');
  });
});

describe('categoriaPorReglas', () => {
  const reglas = [
    { comercio: 'SUPERCOR', categoria: 'Alimentación' },
    { comercio: 'ALQUILER', categoria: 'Vivienda' },
  ];
  it('aplica la regla cuando el concepto contiene el comercio', () => {
    expect(categoriaPorReglas('PAGO SUPERCOR SEVILLA', reglas)).toBe('Alimentación');
  });
  it('devuelve null si ninguna regla coincide', () => {
    expect(categoriaPorReglas('PAGO EN ZARA', reglas)).toBeNull();
  });
  it('sin reglas devuelve null', () => {
    expect(categoriaPorReglas('SUPERCOR', [])).toBeNull();
  });
});
